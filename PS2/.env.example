# Copy to .env and fill in. Never commit .env.
# LTA DataMall AccountKey — register free at https://datamall.lta.gov.sg
LTA_ACCOUNT_KEY=

# OneMap API token — register free at https://www.onemap.gov.sg/apidocs/
# JWT valid 3 days; re-mint via POST /api/auth/post/getToken
ONEMAP_TOKEN=

# Web Push keys (D4). Generate a pair with:
#   backend/.venv/bin/python backend/scripts/gen_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:you@example.org
